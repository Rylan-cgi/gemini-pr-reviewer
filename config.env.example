# =============================================================================
# Automated PR Reviewer Daemon - Configuration Template
# 
# Instructions:
#   1. Copy this file to create your local private configuration:
#      cp config.env.example config.env
#   2. Edit the local variables below with your paths and preferences.
#   3. Note: config.env is gitignored and will never be committed.
# =============================================================================

# The absolute path to your target git repository directory clone
# This allows the daemon to be run from any folder or path on your system
REPO_DIR="/path/to/your/target/repo/clone"

# The polling interval in seconds (default: 300 seconds = 5 minutes)
POLL_INTERVAL=300

# Review Mode:
#   "manual"    - Always prompt for confirmation in active terminals before posting to GitHub.
#   "automatic" - Automatically post reviews to GitHub immediately without prompting.
REVIEW_MODE="manual"

# The path to your local reviewed state tracking JSON file
STATE_FILE="~/.gemini/tmp/ilcr-pr-reviews.json"

# Maximum line count limit for the PR diff to prevent massive token waste
MAX_DIFF_LINES=10000

# Regex pattern for files that should trigger a code review (source code + configs + Caddy)
# Includes all backend/frontend files (source + configs) plus container configurations,
# while naturally ignoring heavy auto-generated dependency lockfiles.
IN_SCOPE_PATHS="backend/|frontend/|Caddyfile|docker-compose.yml"

# Space-separated list of GitHub usernames whose open PRs should be IGNORED
# By default, ignores automated dependency update bots that do not need AI reviews.
BLOCKED_AUTHORS="dependabot dependabot[bot] renovate renovate[bot]"

# Enterprise Authentication:
#   Set to true if using corporate/enterprise SSO (Application Default Credentials).
#   This suppresses the GEMINI_API_KEY warning and unsets API keys for Vertex AI.
#   This is the standard configuration for CGI Vertex AI environments.
ENTERPRISE_AUTH=true

# =============================================================================
# Optional: Remote Corporate Agent Skill Integration
# =============================================================================

# Set to true to dynamically fetch and enforce your organization's latest
# PR review skill file from your corporate enterprise GitHub on every run.
FETCH_REMOTE_SKILL=true

# The corporate repository containing the shared review skill markdown file
REMOTE_SKILL_REPO="BCNRS/agent-skills"

# The relative path to the SKILL.md file inside the corporate repository
REMOTE_SKILL_PATH="skills/pr-review/SKILL.md"

# The corporate enterprise GitHub API hostname
REMOTE_SKILL_HOST="github.pacasource.ent.cgi.com"
